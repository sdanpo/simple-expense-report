# Copy to local.properties (gitignored). Android Studio sets sdk.dir automatically.
sdk.dir=/Users/YOU/Library/Android/sdk

# App config is read from gradle.properties / -P flags / ~/.gradle/gradle.properties,
# NOT this file. Put secrets in ~/.gradle/gradle.properties or pass at build time:
#   ./gradlew :app:assembleRelease -PINBOUND_TOKEN=xxxx -PBASE_URL=https://your.app
#
# Properties:
#   BASE_URL              backend base (default https://simpleexpensereport.vercel.app)
#   INBOUND_TOKEN         must match a backend INBOUND_TOKENS / CRON_SECRET value
#   GOOGLE_WEB_CLIENT_ID  OAuth web client id (optional; enables Google Sign-In)
