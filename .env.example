# Google Service Account (paste the entire JSON as a single line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# Gmail + Drive OAuth (Desktop client). REFRESH_TOKEN is minted by
# `node scripts/setup-gmail-auth.js` (loopback flow). Used by /api/inbound to archive
# receipt images into Drive /Processed, and by the ingest-gmail cron.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# Google Drive Folder IDs (already created — do not change)
GOOGLE_DRIVE_INBOX_ID=1eaCs2dx-ZxwZYGA6xaqNQrKXblO7xWQG
GOOGLE_DRIVE_PROCESSED_ID=1qRyuo0sPXpEQfZfeaQfVQfix20w0tGyr
GOOGLE_DRIVE_IGNORED_ID=1PctH71brnmHySD1VSolcy4kek3ca4svW

# Google Sheets ID (already created — do not change)
GOOGLE_SHEETS_ID=1dSWFwyXy9wdXMYpjPsrbRCPDVZj8_bI2d4qauCkIAA8

# Secret for authenticating cron endpoints (generate a random string)
CRON_SECRET=

# Bearer tokens accepted by POST /api/inbound (the Android app's photo upload).
# Comma-separated; CRON_SECRET is also accepted. Leave empty to allow all (dev only).
INBOUND_TOKENS=

# (optional) Max Gmail messages processed per /api/cron/ingest-gmail run; default 8.
MAX_GMAIL_PER_RUN=
